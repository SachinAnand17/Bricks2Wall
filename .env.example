# ==============================================================================
# Bricks2Wall Production Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. AWS ECS, Vercel, Railway, Docker), set these via your secrets manager.
# NEVER commit .env or .env.local to GitHub.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000
NEXT_PUBLIC_APP_URL=https://bricks2wall.com

# Admin Authentication & Credential Management
# Default superadmin identity: Sachin
ADMIN_USERNAME=Sachin
ADMIN_PASSWORD=your_strong_admin_password_here

# Cryptographic Session & Signing Secret (Minimum 32 random characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET=generate_a_random_32_byte_secret_here_for_production_sessions

# Database Encryption Key (AES-256-GCM authenticated encryption for sensitive PII)
# Generate with: openssl rand -hex 32
DATABASE_ENCRYPTION_KEY=generate_a_random_32_byte_hex_key_here_for_pii_encryption

# Cloud Infrastructure & Storage (Optional for AWS S3 / CloudFront deployment)
AWS_REGION=ap-south-1
# S3_BUCKET_NAME=b2w-property-assets-prod
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Production Database (When transitioning from file store to PostgreSQL RDS)
# DATABASE_URL=postgresql://b2w_admin:password@localhost:5432/bricks2wall
